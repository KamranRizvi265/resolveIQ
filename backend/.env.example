SNOWFLAKE_PAT="your-snowflake-pat"
SNOWFLAKE_ACCOUNT_IDENTIFIER="your-account-identifier"
# Alternatively set the complete endpoint instead of SNOWFLAKE_ACCOUNT_IDENTIFIER.
# SNOWFLAKE_CORTEX_BASE_URL="https://your-account-identifier.snowflakecomputing.com/api/v2/cortex/v1"
LLM_MODEL_NAME="llama3.1-70b"
# Required in production; controls deterministic PII pseudonymization.
PII_HASH_KEY="replace-with-a-long-random-secret"
SECRET_KEY="your_secret_key_here"
DATABASE_URL="sqlite+aiosqlite:///test.db"
